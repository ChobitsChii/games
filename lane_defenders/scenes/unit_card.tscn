[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/unit_card.gd" id="1_card"]

[node name="UnitCard" type="PanelContainer"]
custom_minimum_size = Vector2(100, 120)
offset_right = 100.0
offset_bottom = 120.0
