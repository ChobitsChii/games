[internationalization]

locale/translations=PackedStringArray("res://addons/shared/i18n/common.de.translation", "res://addons/shared/i18n/common.en.translation", "res://i18n/asteroid_drift.de.translation", "res://i18n/asteroid_drift.en.translation")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="asteroids"
2d_physics/layer_3="player_bullets"
2d_physics/layer_4="enemies"
2d_physics/layer_5="enemy_bullets"
2d_physics/layer_6="pickups"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.05, 1)
